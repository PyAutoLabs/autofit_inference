#!/bin/bash -l
#
# GENERATED by scripts/misc/tooling/plan_wave2.py -- do not edit by hand. Change the
# planner, run it with --write and commit; lint runs it with --check.
#
# Wave-2 probes: 20 array tasks, one run each, for the probe-first cells.
#
# These cells have no pilot wall (Zeus on JAX was stopped at the pilot's wall cap; NSS
# runs its new 50-step entry), so they have no frozen timeout yet. Each runs 5 seeds on
# data realisation 1 under a per-run cap; the cell's timeout is then max(600 s, 10 x
# the probe median) (protocol 11 A2) and its remaining runs are submitted in B5b.
#
# CPU jobs run on --partition=ral ONLY: never gpu, ral,gpu or gpu,ral (the human's hard
# rule of 2026-09-30; PyAutoMind/policy/hpc_ral.md). The --exclude keeps these small
# tasks off the four 252-CPU nodes, the only ones a whole-node job of another campaign
# fits on. The PyAuto libraries come from the PRIVATE pin under
# /mnt/ral/jnightin/autofit_inference/.pyauto_pin/, PYTHONPATH-prefixed below; the
# shared /mnt/ral/jnightin/PyAuto mirror provides only the venv and is never pulled.
#
# WALL-BASIS: -- one row per cell this submit runs; walls measured on the B2/B3 laptop
#   cell: gaussian_x3_blend/searches/nss/gaussian_x3  device: ral_cpu  precision: fp64
#   lanes: 1  steps: 1  source: unmeasured  probe-first: yes
#   cell: gaussian_x3_blend/searches/zeus/gaussian_x3  device: ral_cpu  precision: fp64
#   lanes: 1  steps: 1  source: unmeasured  probe-first: yes
#   cell: gaussian_x3_separated/searches/nss/gaussian_x3  device: ral_cpu  precision: fp64
#   lanes: 1  steps: 1  source: unmeasured  probe-first: yes
#   cell: gaussian_x3_separated/searches/zeus/gaussian_x3  device: ral_cpu  precision: fp64
#   lanes: 1  steps: 1  source: unmeasured  probe-first: yes
#SBATCH -J w2_probe
#SBATCH --partition=ral
#SBATCH --exclude=euclid-ral-compute-[1-4]
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=6gb
#SBATCH --time=12:17:00
#SBATCH --array=0-19%20
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT=/mnt/ral/jnightin/autofit_inference
source $AP_ROOT/activate.sh

# The private pin: PyAutoFit df6d218f10cd75a7f0d79bb03dca5c131fd29d33, PyAutoNerves
# 7f3055b7f3d1967f372bdb41ee732135bca0e68d. Prefixed, so it wins over the shared checkouts that
# activate.sh puts on PYTHONPATH; a wave-2 run refuses any other PyAutoFit commit.
# $AF_PIN/site holds the third-party packages the pin needs that the shared venv lacks
# (zeus-mcmc==2.5.4), unpacked from their wheels: the shared venv is
# never modified.
export AF_PIN=$AP_ROOT/.pyauto_pin
export PYTHONPATH="$AF_PIN/PyAutoNerves:$AF_PIN/PyAutoFit:$AF_PIN/site${PYTHONPATH:+:$PYTHONPATH}"

export JAX_PLATFORMS=cpu
# Every submit exports this explicitly: without it an fp64 config silently runs fp32.
export JAX_ENABLE_X64=True
# One search per process at --cores 1, as in the pilot.
export NPROC=1

echo "=========================================="
date
cd $AP_ROOT
# Refuse to run anything unless both pins are at their commits and are what imports.
test "$(git -C $AF_PIN/PyAutoFit rev-parse HEAD)" = "df6d218f10cd75a7f0d79bb03dca5c131fd29d33"
test "$(git -C $AF_PIN/PyAutoNerves rev-parse HEAD)" = "7f3055b7f3d1967f372bdb41ee732135bca0e68d"
python3 -c "import autofit, autonerves, os; pin = os.environ['AF_PIN']; assert autofit.__file__.startswith(pin) and autonerves.__file__.startswith(pin), (autofit.__file__, autonerves.__file__); print('autofit', autofit.__version__, autofit.__file__); print('autonerves', autonerves.__file__)"

TASKS=hpc/batch_cpu/wave2/probe.tsv
LINE=$(sed -n "$((SLURM_ARRAY_TASK_ID + 2))p" "$TASKS")
if [ -z "$LINE" ]; then echo "no task line $SLURM_ARRAY_TASK_ID in $TASKS" >&2; exit 1; fi
read -r DATASET SAMPLER SETTINGS CONFIG DATA_SEED LIMIT SEEDS <<< "$LINE"
echo "task $SLURM_ARRAY_TASK_ID: $LINE"
for SEED in ${SEEDS//,/ }; do
    case "$DATASET/$SAMPLER" in
        gaussian_x3_blend/nss)
            timeout -s TERM -k 300 "$LIMIT" python3 scripts/gaussian_x3_blend/searches/nss/gaussian_x3.py --wave 2 --config-name "$CONFIG" --settings "$SETTINGS" --data-seed "$DATA_SEED" --seed "$SEED" --cores 1 || echo "run gaussian_x3_blend/nss/$SETTINGS/data_seed$DATA_SEED/seed$SEED exited $? (its row, if any, records the failure)"
            ;;
        gaussian_x3_blend/zeus)
            timeout -s TERM -k 300 "$LIMIT" python3 scripts/gaussian_x3_blend/searches/zeus/gaussian_x3.py --wave 2 --config-name "$CONFIG" --settings "$SETTINGS" --data-seed "$DATA_SEED" --seed "$SEED" --cores 1 || echo "run gaussian_x3_blend/zeus/$SETTINGS/data_seed$DATA_SEED/seed$SEED exited $? (its row, if any, records the failure)"
            ;;
        gaussian_x3_separated/nss)
            timeout -s TERM -k 300 "$LIMIT" python3 scripts/gaussian_x3_separated/searches/nss/gaussian_x3.py --wave 2 --config-name "$CONFIG" --settings "$SETTINGS" --data-seed "$DATA_SEED" --seed "$SEED" --cores 1 || echo "run gaussian_x3_separated/nss/$SETTINGS/data_seed$DATA_SEED/seed$SEED exited $? (its row, if any, records the failure)"
            ;;
        gaussian_x3_separated/zeus)
            timeout -s TERM -k 300 "$LIMIT" python3 scripts/gaussian_x3_separated/searches/zeus/gaussian_x3.py --wave 2 --config-name "$CONFIG" --settings "$SETTINGS" --data-seed "$DATA_SEED" --seed "$SEED" --cores 1 || echo "run gaussian_x3_separated/zeus/$SETTINGS/data_seed$DATA_SEED/seed$SEED exited $? (its row, if any, records the failure)"
            ;;
        *) echo "unknown cell $DATASET/$SAMPLER" >&2; exit 1 ;;
    esac
done

echo "Finished."
date
